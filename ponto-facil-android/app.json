{
  "expo": {
    "name": "Ponto Fácil",
    "slug": "ponto-facil-android",
    "version": "1.0.106",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5E123D"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pontofacil.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5E123D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 108
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "smallIcons": [
            "./assets/notification_icon.png"
          ],
          "smallIconAccentColor": "#FF5E123D"
        }
      ],
      "./withNotificationSound"
    ],
    "extra": {
      "eas": {
        "projectId": "1be499dc-d205-4c9e-8f08-eec60f00465b"
      }
    }
  }
}